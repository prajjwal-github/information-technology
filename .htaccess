# Apache web server settings (optional: only used when the site is hosted on Apache)
# Lets the old addresses keep working: /about opens about.html
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Old address with a capital letter -> lowercase page
  RewriteRule ^Training$ training.html [R=301,L]
  # /page -> page.html (when that file exists)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([A-Za-z0-9_-]+)$ $1.html [L]
</IfModule>
